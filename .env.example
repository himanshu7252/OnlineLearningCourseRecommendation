# ==========================================
# Backend Express Server Configuration
# ==========================================
PORT=5000
# For Local MongoDB: mongodb://localhost:27017/online-learning-db
# For MongoDB Atlas: mongodb+srv://<username>:<password>@cluster0.xxxxxx.mongodb.net/online-learning-db?retryWrites=true&w=majority
MONGO_URI=mongodb://localhost:27017/online-learning-db
JWT_SECRET=supersecretjwtkeyforrecommendationapp123!

# ==========================================
# Mobile React Native Configuration
# ==========================================
# Note: For physical Android devices, use your local machine's IP (e.g. http://192.168.1.50:5000/api)
# For Android Emulator, use http://10.0.2.2:5000/api
# For iOS Simulator, use http://localhost:5000/api
API_BASE_URL=http://10.0.2.2:5000/api
